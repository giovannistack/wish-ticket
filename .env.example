# ---- Server ----
NODE_ENV=production
HOST=127.0.0.1
PORT=8040
# Indirizzo pubblico dell'app (usato nei link delle email)
URL_PUBBLICO=https://ticket.wishsrl.it

# ---- Database (utente con permessi readWrite solo su wish_ticket) ----
MONGO_URI=mongodb://wish_ticket:CAMBIA_PASSWORD@127.0.0.1:27017/wish_ticket?authSource=wish_ticket

# ---- Sicurezza ----
# Almeno 32 caratteri casuali. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_MINUTI=15
REFRESH_TOKEN_GIORNI=30

# ---- Email (SMTP del dominio wishsrl.it) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wish Assistenza <assistenza@wishsrl.it>
# Dove arrivano gli avvisi per l'admin (nuove registrazioni, nuovi ticket)
EMAIL_AVVISI_ADMIN=

# ---- Solo per il primo avvio (npm run seed) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=
ADMIN_COGNOME=
